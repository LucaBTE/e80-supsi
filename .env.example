# Copy to .env and fill in. Variables set in the shell win over this file.
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
# Matches the isolated sample database in compose.yaml.
NEO4J_PASSWORD=e80-demo-password
GOOGLE_API_KEY=
# Gemini model for every LLM step
E80KB_MODEL=gemini-flash-latest
# ACL groups every request reads with (no login yet), comma separated
E80KB_GROUPS=Internal
